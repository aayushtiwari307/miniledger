# Development-only local credentials. Never use these values in production.
POSTGRES_USER=miniledger
POSTGRES_PASSWORD=miniledger_dev_password
POSTGRES_DB=miniledger
DATABASE_URL=postgresql://miniledger:miniledger_dev_password@127.0.0.1:15432/miniledger
DATABASE_TEST_URL=postgresql://miniledger:miniledger_dev_password@127.0.0.1:15432/miniledger_test

# The API binds to all interfaces so a phone on the same Wi-Fi can reach it.
API_HOST=0.0.0.0
API_PORT=3001

# Replace both values with random secrets of at least 32 characters before running auth.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_TTL_SECONDS=604800
OTP_HMAC_SECRET=replace-this-with-a-different-random-secret-at-least-32-chars
OTP_TTL_SECONDS=300
OTP_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
