# Android emulator can reach the host machine at 10.0.2.2.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3001

# For a physical phone, replace the value with your computer's LAN IPv4 address, e.g.:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.25:3001
# The phone and computer must be on the same Wi-Fi. Allow Node.js through Windows Firewall if prompted.
